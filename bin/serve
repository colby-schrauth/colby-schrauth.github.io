#!/usr/bin/env bash
# Preview the site (including drafts) at http://localhost:4000
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="/opt/homebrew/opt/ruby@3.3/bin:$PATH" # GitHub Pages' Jekyll doesn't run on Ruby 4
export LANG="${LANG:-en_US.UTF-8}"
bundle exec jekyll serve --drafts --livereload "$@"
